# Copie ce fichier en .env.local et remplis les valeurs.
# NE COMMITE JAMAIS .env ni .env.local (déjà couverts par .gitignore).

# ---------------------------------------------------------------------------
# Bot Telegram (utilisé par api/bot.js)
# ---------------------------------------------------------------------------
# Obtenu via @BotFather. En production, à définir dans Vercel -> Settings -> Environment Variables
TELEGRAM_BOT_TOKEN=remplace_moi
DEEPSEEK_API_KEY=remplace_moi

# ---------------------------------------------------------------------------
# Email Domain Security (utilisé par api/analyze.js et api/history.js)
# ---------------------------------------------------------------------------
# Ces deux variables sont SERVEUR UNIQUEMENT : jamais de préfixe NEXT_PUBLIC_,
# jamais dans index.html, jamais dans Git.
SUPABASE_URL=
# Clé secrète (sb_secret_...) ou service_role. C'est elle qui écrit dans la table,
# le RLS reste fermé au navigateur.
SUPABASE_SECRET_KEY=

# Facultatif : si absent, l'application fonctionne normalement sans VirusTotal.
VIRUSTOTAL_API_KEY=

# Facultatif : 1 = n'interroge que la liste locale de domaines jetables
# (utilisé par les tests hors ligne).
EDS_OFFLINE=

# ---------------------------------------------------------------------------
# NOTE : les variables NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# ne sont plus utilisées. Le navigateur ne parle plus à Supabase directement :
# tout passe par /api/analyze et /api/history, côté serveur.
# ---------------------------------------------------------------------------
