# Copie ce fichier en .env et remplis les valeurs.
# NE COMMITE JAMAIS .env

# --- Bot Telegram (utilisé par api/bot.js) ---
# Obtenu via @BotFather. En production, à définir dans Vercel > Settings > Environment Variables
TELEGRAM_BOT_TOKEN=remplace_moi

# --- Supabase (utilisé par index.html, côté client) ---
# URL et clé "publishable" : OK côté client SI Row Level Security est activé sur toutes les tables
NEXT_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=remplace_moi
